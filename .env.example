# Conseguí tu API key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo preferido al arrancar (opcional, por defecto gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# Modelos de respaldo, separados por coma. Si uno devuelve 404/503/429/500/504
# se prueba el siguiente; el que responde queda como favorito.
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-flash-latest,gemini-flash-lite-latest
