# Conseguí tu API key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo preferido al arrancar (opcional, por defecto gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Modelos de respaldo, separados por coma. Si uno devuelve 503/429/500/504
# se prueba el siguiente; el que responde queda como favorito.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite
